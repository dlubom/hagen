# Osobny skład przekrojów w skali 1:300, poza geometrią rzutu jaskini.
scrap panel -projection [elevation 0] -scale [0 0 100 0 0 0 25 0 m]
point 55 60 section -scrap przekroj30
point 55 34 label -text "<bf>30" -scale m
point 55 26 label -text "20 x 7 m" -scale s
point 124 60 section -scrap przekroj34
point 124 34 label -text "<bf>34" -scale m
point 124 26 label -text "5 x 5,7 m" -scale s
point 167 60 section -scrap przekroj52
point 167 34 label -text "<bf>52" -scale m
point 167 26 label -text "3 x 1,7 m" -scale s
point 210 60 section -scrap przekroj72
point 210 34 label -text "<bf>72" -scale m
point 210 26 label -text "3 x 7,7 m" -scale s
endscrap
